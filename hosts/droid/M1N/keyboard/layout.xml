<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  TLTR for the Termux Launcher's built-in keyboard (~/.termux/keyboard/layout.xml).
  https://github.com/DivitMittal/TLTR

  QWERTY for the letters; TLTR's layers stay positional, so TR and TL sit on the
  same keys as on the Piantor/kanata layout whatever letter is printed there. The
  on-screen keyboard has no layers, so they are folded onto each key:

    tap                    base layer (QWERTY)
    ne swipe / sw swipe    TR layer: the symbol / its TLTR-shifted symbol
    nw swipe / se swipe    keys from TLTR's outer columns and launcher extras
    Fn + key               TL layer (navigation), and F1-F12 on TR's numpad
    Shift + key            TLTR's own shifted pairs (, _  . ?  / \  ...)

  Fn is the TL thumb key; tap to latch it for one key, hold to lock it.
  Rendered in keymap.svg next to this file (see keymap.yml).
-->
<keyboard bottom_row="false" name="TLTR QWERTY" script="latin">
  <row>
    <key c="q" ne="!" sw="`" se="esc"/>
    <key c="w" ne="\@" sw="~"/>
    <key c="e" ne="\#" sw="^"/>
    <key c="r" ne="$" sw="₹"/>
    <key c="t"/>
    <key c="y" ne="%" split_before="true"/>
    <key c="u" ne="7"/>
    <key c="i" ne="8"/>
    <key c="o" ne="9"/>
    <key c="p" ne="+" sw="=" nw="'" se="&quot;"/>
  </row>
  <row>
    <key c="a" ne="&amp;" sw="|" nw="tab"/>
    <key c="s" ne="[" sw="]"/>
    <key c="d" ne="{" sw="}"/>
    <key c="f" ne="(" sw=")"/>
    <key c="g"/>
    <key c="h" ne="*" split_before="true"/>
    <key c="j" ne="4"/>
    <key c="k" ne="5"/>
    <key c="l" ne="6"/>
    <key c=";" ne="-" sw="–"/>
  </row>
  <row>
    <key c="z"/>
    <key c="x"/>
    <key c="c" ne="&lt;"/>
    <key c="v" ne="&gt;"/>
    <key c="b"/>
    <key c="n" ne="0" split_before="true"/>
    <key c="m" ne="1"/>
    <key c="," ne="2" sw="_"/>
    <key c="." ne="3" sw="\?"/>
    <key c="/" ne="/" sw="\\"/>
  </row>
  <!-- TLTR thumbs are TL | Shift | Space | TR; TR lives on the swipes above. -->
  <row height="0.95">
    <key width="1.2" c="ctrl" ne="meta" sw="switch_clipboard" se="switch_numeric"/>
    <key width="1.1" c="fn" nw="alt" ne="change_method" se="config"/>
    <key width="1.2" c="shift" ne="capslock"/>
    <key width="2.9" c="space" split_at="1.45" w="cursor_left" e="cursor_right" s="switch_backward"
         n="tool:app.command_palette:󱎱"
         nw="tool:window.previous:󰜳" ne="tool:window.next:󰜶"
         sw="tool:session.previous:󰜹" se="tool:session.next:󰜰"/>
    <key width="1.1" c="compose" nw="home" ne="page_up" sw="page_down" se="end" w="left" e="right" n="up" s="down"/>
    <key width="1.2" c="backspace" ne="delete"/>
    <key width="1.3" c="enter" n="voice_typing"/>
  </row>
  <modmap>
    <!-- TL: navigation on the right hand, as on the Piantor. -->
    <fn a="q" b="esc"/>
    <fn a="y" b="page_up"/>
    <fn a="u" b="home"/>
    <fn a="i" b="up"/>
    <fn a="o" b="end"/>
    <fn a="h" b="page_down"/>
    <fn a="j" b="left"/>
    <fn a="k" b="down"/>
    <fn a="l" b="right"/>
    <fn a="m" b="backspace"/>
    <fn a="," b="delete"/>
    <!-- TR's F-key legends: Fn + a number swipe gives the F-key. -->
    <fn a="1" b="f1"/>
    <fn a="2" b="f2"/>
    <fn a="3" b="f3"/>
    <fn a="4" b="f4"/>
    <fn a="5" b="f5"/>
    <fn a="6" b="f6"/>
    <fn a="7" b="f7"/>
    <fn a="8" b="f8"/>
    <fn a="9" b="f9"/>
    <fn a="0" b="f10"/>
    <fn a="*" b="f11"/>
    <fn a="%" b="f12"/>
    <!-- TLTR's shifted pairs, where they differ from US ANSI. -->
    <shift a="'" b="&quot;"/>
    <shift a=";" b=":"/>
    <shift a="," b="_"/>
    <shift a="." b="\?"/>
    <shift a="/" b="\\"/>
    <shift a="!" b="`"/>
    <shift a="\@" b="~"/>
    <shift a="\#" b="^"/>
    <shift a="$" b="₹"/>
    <shift a="&amp;" b="|"/>
    <shift a="[" b="]"/>
    <shift a="{" b="}"/>
    <shift a="(" b=")"/>
    <shift a="=" b="—"/>
    <shift a="-" b="–"/>
  </modmap>
</keyboard>
